#!/usr/bin/env bash
# Git Post-Checkout Hook: gh-Only Identity & Auto-Rollback Guardrail
# Version: 3.0.0 | Universal AI-SDLC Framework

set -e

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LIB_IDENTITY="$SCRIPT_DIR/../scripts/lib-identity.sh"

if [ -f "$LIB_IDENTITY" ]; then
    # shellcheck source=/dev/null
    source "$LIB_IDENTITY"
else
    exit 0
fi

PREV_HEAD="$1"
NEW_HEAD="$2"
IS_BRANCH_CHECKOUT="$3"

# Hanya eksekusi pada checkout cabang (bukan file checkout)
if [ "$IS_BRANCH_CHECKOUT" != "1" ]; then
    exit 0
fi

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

if [ "$BRANCH" = "HEAD" ] || [ -z "$BRANCH" ]; then
    exit 0
fi

TEAM_BOARD=".ai/TEAM-BOARD.md"

find_user_branch() {
    local target_user="$1"
    local board_file="$2"
    if [ -f "$board_file" ] && [ -n "$target_user" ]; then
        awk -F'|' -v u="$target_user" '
            $8 !~ /MERGED/ && tolower($6) ~ u {
                gsub(/[`* ]/, "", $7);
                if ($7 != "" && $7 !~ /Belum/) {
                    print $7;
                    exit;
                }
            }
        ' "$board_file"
    fi
}

# ----------------------------------------------------------------------
# 1. ENFORCEMENT PADA CABANG TUGAS (task/*)
# ----------------------------------------------------------------------
if [[ "$BRANCH" =~ ^task/ ]]; then
    # Validasi login GitHub (fail-closed)
    GH_USER=$(gov_get_auth_user 2>/dev/null || echo "")
    if [ -z "$GH_USER" ]; then
        echo ""
        echo "======================================================================"
        echo "❌ [CHECKOUT GUARDRAIL] AKSES DITOLAK: GITHUB CLI BELUM LOGIN!"
        echo "======================================================================"
        echo "Cabang tugas ($BRANCH) memerlukan autentikasi resmi GitHub CLI."
        echo "Silakan login terlebih dahulu melalui terminal:"
        echo "   gh auth login"
        echo ""
        echo "Mengembalikan ke cabang sebelumnya secara otomatis..."
        echo "======================================================================"
        echo ""
        git checkout - &>/dev/null || git checkout development &>/dev/null || true
        exit 1
    fi

    GH_USER_LOWER=$(echo "$GH_USER" | tr '[:upper:]' '[:lower:]')

    if [ -f "$TEAM_BOARD" ]; then
        ASSIGNED=$(grep -F "$BRANCH" "$TEAM_BOARD" | head -n 1 | awk -F'|' '{print $6}' | tr -d '`*' | xargs)

        if [ -n "$ASSIGNED" ] && [ "$ASSIGNED" != "PENDING_ASSIGNMENT" ] && [ "$ASSIGNED" != "PENDING_REASSIGNMENT" ] && [ "$ASSIGNED" != "UNASSIGNED" ]; then
            ASSIGNED_LOWER=$(echo "$ASSIGNED" | tr '[:upper:]' '[:lower:]' | tr -d '@')

            if [ "$GH_USER_LOWER" != "$ASSIGNED_LOWER" ]; then
                echo ""
                echo "======================================================================"
                echo "❌ [CHECKOUT GUARDRAIL] AKSES DITOLAK: BUKAN CABANG TUGAS ANDA!"
                echo "======================================================================"
                echo "Cabang target     : $BRANCH"
                echo "Sesi GitHub aktif : @$GH_USER"
                echo "Penugasan resmi   : @$ASSIGNED"
                echo ""
                echo "Akun Anda TIDAK memiliki hak akses pada cabang ini."
                MY_BRANCH=$(find_user_branch "$GH_USER_LOWER" "$TEAM_BOARD")
                if [ -n "$MY_BRANCH" ]; then
                    echo "Cabang tugas sah milik Anda: 👉 $MY_BRANCH"
                fi
                echo "Mengembalikan ke cabang sebelumnya secara otomatis..."
                echo "======================================================================"
                echo ""
                git checkout - &>/dev/null || git checkout development &>/dev/null || true
                exit 1
            fi
        fi
    fi
fi

exit 0
